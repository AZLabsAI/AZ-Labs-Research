# Firecrawl API Key
# Get your API key from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-YOUR_API_KEY_HERE

# Groq API Key
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Supabase Configuration
# Current answer provider (server-only; existing model selection is preserved).
META_API_KEY=

# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only adoption gates. Leave disabled until the reviewed identity gate and RLS migration are proven.
AZLABS_PLATFORM_ORIGIN=https://azlabs.ai
AZLABS_RESEARCH_ORIGIN=https://research.azlabs.ai
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_SESSION_ENCRYPTION_KEY=
RESEARCH_CENTRAL_ISSUANCE_GATE_VERIFIED=0
RESEARCH_SESSION_BINDINGS_READY=0

# Set to central only after the Supabase provider, resource audience, mapping and RLS gates are configured.
NEXT_PUBLIC_AZLABS_AUTH_MODE=legacy
NEXT_PUBLIC_AZLABS_AUTH_PROVIDER=custom:azlabs
